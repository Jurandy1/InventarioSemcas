rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function isAuth() {

      return request.auth != null;

    }



    function invDoc() {

      return get(/databases/$(database)/documents/inventariantes/$(request.auth.uid));

    }



    function coordDoc() {

      return get(/databases/$(database)/documents/coordenadores/$(request.auth.uid));

    }



    function isInventarianteAtivo() {

      return isAuth() && exists(invDoc()) && invDoc().data.status == 'aprovado';

    }



    function isCoordAprovada() {

      return isAuth() && exists(coordDoc()) && coordDoc().data.status == 'aprovada';

    }



    function isAdminUser() {

      return isAuth() && request.auth.uid == 'fC7cWAbUKEY7wGMHdN9z9dcdvX03';

    }



    function isInventarianteOuAdmin() {

      return isAdminUser() || isInventarianteAtivo();

    }



    function unidadePermitidaInv(unidadeId) {

      return isInventarianteAtivo() && (

        (invDoc().data.unidadeIds is list && unidadeId in invDoc().data.unidadeIds) ||

        invDoc().data.unidadeId == unidadeId

      );

    }



    function unidadePermitidaCoord(unidadeId) {

      return isCoordAprovada() && (

        (coordDoc().data.unidadeIds is list && unidadeId in coordDoc().data.unidadeIds) ||

        coordDoc().data.unidadeId == unidadeId

      );

    }



    function podeUnidade(unidadeId) {

      return isAdminUser() || unidadePermitidaInv(unidadeId) || unidadePermitidaCoord(unidadeId);

    }



    function campanhaFechada() {

      return exists(/databases/$(database)/documents/campanhas/ativa) &&

        get(/databases/$(database)/documents/campanhas/ativa).data.status == 'fechada';

    }



    function writesPermitidos() {

      return !campanhaFechada() || isInventarianteOuAdmin();

    }



    match /convites/{conviteId} {

      allow get: if true;

      allow list: if false;

      allow create: if isInventarianteOuAdmin();

      allow update: if isInventarianteOuAdmin() || (
        isAuth() &&
        resource.data.status == 'ativo' &&
        request.resource.data.status == 'usado'
      );

      allow delete: if false;

    }



    function conviteInventarianteCreateValido() {

      return request.resource.data.status == 'ativo' &&

        request.resource.data.criadoPor == request.auth.uid &&

        request.resource.data.dataCriacao is string &&

        request.resource.data.dataExpiracao is string;

    }



    match /convites_inventariantes/{conviteId} {

      allow get: if true;

      allow list: if false;

      allow create: if isAuth() && isAdminUser() && conviteInventarianteCreateValido();

      allow update: if isAdminUser() || (
        isAuth() &&
        resource.data.status == 'ativo' &&
        request.resource.data.status == 'usado' &&
        request.resource.data.usadoPor == request.auth.uid
      );

      allow delete: if false;

    }



    match /campanhas/{docId} {

      allow read: if isAuth();

      allow create, update: if isInventarianteOuAdmin() || isCoordAprovada();

      allow delete: if isAdminUser();

    }



    match /coordenadores/{uid} {

      allow create: if isAuth() && request.auth.uid == uid;

      allow get: if isAuth() && (request.auth.uid == uid || isInventarianteOuAdmin());

      allow list: if isInventarianteOuAdmin();

      allow update: if isAuth() && (request.auth.uid == uid || isInventarianteOuAdmin());

    }



    match /inventariantes/{uid} {

      allow create: if isAuth() && request.auth.uid == uid;

      allow get: if isAuth() && (request.auth.uid == uid || isAdminUser());

      allow list: if isAdminUser();

      allow update: if isAuth() && (request.auth.uid == uid || isAdminUser());

    }



    match /inventario/{docId} {

      // Leitura liberada para qualquer usuário autenticado (app interno SEMCAS).
      // Gravação continua restrita por papel/unidade abaixo.
      allow read: if isAuth();

      allow create, update: if writesPermitidos() && isAuth() && (

        isAdminUser() ||

        unidadePermitidaInv(request.resource.data.unidadeId) ||

        unidadePermitidaCoord(request.resource.data.unidadeId)

      );

      allow delete: if isInventarianteOuAdmin();

    }



    match /manuais/{docId} {

      allow read: if isAuth();

      allow create, update: if writesPermitidos() && isAuth() && (

        isAdminUser() || unidadePermitidaInv(request.resource.data.unidadeId)

      );

      allow delete: if isInventarianteOuAdmin();

    }



    match /locais/{docId} {

      allow read: if isAuth();

      allow create, update: if writesPermitidos() && isAuth() && (

        isAdminUser() || isInventarianteAtivo() || isCoordAprovada()

      );

      allow delete: if isAuth() && (isAdminUser() || isInventarianteAtivo());

    }



    match /presenca_inventario/{uid} {

      allow read: if isAuth();

      allow create, update: if isAuth() && request.auth.uid == uid
        && (!('itemEmEdicao' in request.resource.data) || request.resource.data.itemEmEdicao is string)
        && (!('itemDescricao' in request.resource.data) || request.resource.data.itemDescricao is string);

      allow delete: if isAuth() && request.auth.uid == uid;

    }



    match /tombosNE/{docId} {

      allow read: if isAuth();

      allow write: if isAuth() && (isInventarianteOuAdmin() || isCoordAprovada());

    }



    match /finalizacoes/{docId} {

      allow read: if isAuth();

      allow create: if isAuth() && (isAdminUser() || isInventarianteAtivo() || isCoordAprovada());

      allow update: if isAuth() && (isAdminUser() || isInventarianteAtivo() || isCoordAprovada());

      allow delete: if isAdminUser();

    }



    match /auditoria/{docId} {

      allow read: if isAdminUser();

      allow create: if isAuth();

      allow update, delete: if isAdminUser();

    }



    match /aprovacoes/{docId} {

      allow read, write: if isAuth();

    }



    match /rejeicoes/{docId} {

      allow read, write: if isAuth();

    }



    match /cadastro_indice/{docId} {

      allow get: if true;

      allow list: if false;

      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;

      allow update: if isAdminUser() || (
        isAuth() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid
      );

      allow delete: if isAdminUser();

    }



    match /{document=**} {

      allow read, write: if isAdminUser();

    }

  }

}

