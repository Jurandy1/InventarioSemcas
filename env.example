# Copie para .env na raiz (o arquivo .env NÃO vai para o Git).
# No GitHub: Settings → Secrets and variables → Actions → New repository secret.

VITE_FB_API_KEY=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini (visão) — menu Nomes → "Sugerir com IA (foto)"
# Restrinja a chave por HTTP referrer no Google AI Studio.
VITE_GEMINI_API_KEY=
# Opcional (padrão: gemini-flash-latest)
# VITE_GEMINI_MODEL=gemini-flash-latest
